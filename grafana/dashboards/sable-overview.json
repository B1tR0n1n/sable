    {
      "id": 80,
      "title": "",
      "type": "text",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "transparent": true,
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;gap:12px;padding:4px 8px;font-family:'JetBrains Mono',monospace;font-size:11px;\">\n  <select id=\"sc-sel\" style=\"background:#151311;color:#c8bda0;border:1px solid #2a2520;padding:6px 10px;font-family:'JetBrains Mono',monospace;font-size:11px;border-radius:3px;min-width:300px;height:32px;\">\n    <option value=\"\">Loading...</option>\n  </select>\n  <button id=\"play-btn\" onclick=\"sablePlay()\" style=\"background:#151311;color:#4a7a45;border:1px solid #2a2520;padding:4px 14px;cursor:pointer;border-radius:3px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:2px;\">PLAY</button>\n  <button onclick=\"sableCtrl('reset')\" style=\"background:#151311;color:#a63d2f;border:1px solid #2a2520;padding:4px 14px;cursor:pointer;border-radius:3px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:2px;\">RESET</button>\n  <button id=\"lora-btn\" onclick=\"sableLora()\" style=\"background:#151311;color:#c9a227;border:1px solid #2a2520;padding:4px 14px;cursor:pointer;border-radius:3px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:2px;\">LORA ON</button>\n  <span id=\"sc-status\" style=\"color:#7a7060;margin-left:auto;font-size:10px;\"></span>\n</div>\n<script>\nvar _playing=false,_lora=true;\nvar _proxy='/api/datasources/proxy/uid/sable';\nfunction sablePost(path,body){return fetch(_proxy+path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(r=>r.json())}\nfunction sableGet(path){return fetch(_proxy+path).then(r=>r.json())}\nfunction sableCtrl(action){sablePost('/control',{action:action}).then(function(r){document.getElementById('sc-status').textContent=r.error||''})}\nfunction sablePlay(){_playing=!_playing;sablePost('/control',{action:_playing?'play':'stop'}).then(function(){document.getElementById('play-btn').textContent=_playing?'STOP':'PLAY';document.getElementById('play-btn').style.color=_playing?'#a63d2f':'#4a7a45'})}\nfunction sableLora(){_lora=!_lora;sablePost('/control',{action:'lora',enabled:_lora}).then(function(r){document.getElementById('lora-btn').textContent=r.lora?'LORA ON':'LORA OFF';document.getElementById('lora-btn').style.color=r.lora?'#c9a227':'#7a7060'})}\ndocument.getElementById('sc-sel').addEventListener('change',function(){var n=this.value;if(n)sablePost('/control',{action:'scenario',name:n}).then(function(r){document.getElementById('sc-status').textContent=r.error||''})});\nsableGet('/scenario_list').then(function(r){var sel=document.getElementById('sc-sel');sel.innerHTML='';r.scenarios.forEach(function(s){var o=document.createElement('option');o.value=s;o.textContent=s.replace(/_/g,' ');sel.appendChild(o)})});\nsableGet('/hero').then(function(r){_lora=!!r.lora;document.getElementById('lora-btn').textContent=_lora?'LORA ON':'LORA OFF';document.getElementById('lora-btn').style.color=_lora?'#c9a227':'#7a7060'});\n</script>"
      }
    },
