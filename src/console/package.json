{
  "name": "sable-console",
  "version": "1.0.0",
  "description": "SABLE Operations Console — Infrastructure Failure Simulation + AI Analysis",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build-installer": "electron-builder --win nsis"
  },
  "author": "Keith",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.sable.console",
    "productName": "SABLE Console",
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "files": [
      "main.js",
      "index.html",
      "icon.png"
    ]
  }
}
