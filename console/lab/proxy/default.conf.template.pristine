# Rendered by the nginx image's envsubst step into /etc/nginx/conf.d/default.conf at every
# container start. UPSTREAM_HOST comes from proxy/upstream.env (catalog: failover_to_replica /
# failback_to_primary rewrite it to db-replica / db and restart the proxy). The upstream is
# resolved per request through Docker's DNS so nginx keeps serving (and reporting up=1) when
# the primary is stopped and its name no longer resolves.
resolver 127.0.0.11 valid=5s ipv6=off;

server {
    listen 80;
    server_name proxy proxy.lab;
    set $primary "${UPSTREAM_HOST}";

    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
    proxy_next_upstream off;

    # Prometheus shim: scraping this is what makes Prometheus' synthetic `up` truthful.
    location = /metrics {
        default_type text/plain;
        return 200 "# HELP nginx_up 1 while nginx serves.\n# TYPE nginx_up gauge\nnginx_up 1\n# HELP nginx_upstream_info The fronted primary.\n# TYPE nginx_upstream_info gauge\nnginx_upstream_info{upstream=\"${UPSTREAM_HOST}\"} 1\n";
    }
    location = /stub_status {
        stub_status;
    }

    # The fronted primary (db, or db-replica after a failover). /health is what blackbox probes.
    location = /health {
        proxy_pass http://$primary:8100/health;
    }
    location /kv/ {
        proxy_pass http://$primary:8100$request_uri;
    }
    location = /upstream {
        default_type text/plain;
        return 200 "${UPSTREAM_HOST}\n";
    }

    # The app, for completeness (proxy -> app is a HARD edge in topology.yaml).
    location /app/ {
        proxy_pass http://app:8000/;
    }
}
